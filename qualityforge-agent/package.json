{
  "name": "@qualityforge/agent",
  "version": "0.1.0",
  "description": "QualityForge Agent — planner, orchestration, and quality insights",
  "type": "module",
  "bin": {
    "qualityforge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@qualityforge/core": "*",
    "@qualityforge/dom-intelligence": "*",
    "@qualityforge/jira-agent": "*",
    "@qualityforge/playwright-agent": "*"
  }
}
