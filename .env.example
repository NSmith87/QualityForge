# Copy to .env. Never commit secrets.

APP_ENV=local

# ollama | openai | anthropic | azure_openai
LLM_PROVIDER=ollama
LLM_MODEL=mistral
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Production providers (set only the one you use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

DATABASE_URL=postgresql+psycopg://qualityforge:qualityforge@127.0.0.1:5432/qualityforge

CHROMA_PATH=.chroma
CHROMA_COLLECTION=qualityforge
